# Copy to .env and adjust. .env is gitignored.

# Django
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres.
# Matches the included docker-compose.yml. If you use an existing local
# Postgres instead, point this at it -- check the port, since Homebrew
# installs of different major versions do not all listen on 5432.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/edh_budget_brewer

# Scryfall. Their API requires a descriptive User-Agent identifying your app;
# do not let an HTTP library pick this for you.
SCRYFALL_USER_AGENT=edh-budget-brewer-cli/0.1 (+https://github.com/husomichael/edh-budget-brewer-cli)
